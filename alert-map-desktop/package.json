{
  "name": "alert-map",
  "version": "1.2.0",
  "description": "Мапа Тривог — настільний застосунок",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "audit": "npm audit --omit=dev",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ua.alertmap.app",
    "productName": "Мапа Тривог",
    "asar": true,
    "afterPack": "./afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "MapaTryvog-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}